{{!
    @template local_learnlogic/list
}}
<div class="ll-app ll-list-page ll-app--bleed" data-region="ll-list"
     data-label-battled="{{#str}}battled, local_learnlogic{{/str}}"
     data-label-battled-action="{{#str}}battledaction, local_learnlogic{{/str}}">
    {{> local_learnlogic/header }}

    <nav class="ll-topnav" aria-label="NexPractice">
        <a class="ll-topnav__item is-active" href="{{{listurl}}}">
            <span class="ll-ico ll-ico--book" aria-hidden="true"></span>
            {{#str}}problems, local_learnlogic{{/str}}
        </a>
        <a class="ll-topnav__item" href="{{{leaderboardurl}}}">
            <span class="ll-ico ll-ico--trophy" aria-hidden="true"></span>
            {{#str}}leaderboard, local_learnlogic{{/str}}
        </a>
        <a class="ll-topnav__item" href="{{{submissionsurl}}}">{{#str}}submissions, local_learnlogic{{/str}}</a>
        {{#canmanage}}
            <a class="ll-topnav__item ll-topnav__item--right" href="{{{manageurl}}}">{{#str}}manage, local_learnlogic{{/str}}</a>
        {{/canmanage}}
    </nav>

    <div class="ll-layout ll-layout--full">
        <div class="ll-layout__main">
            <section class="ll-panel">
                <header class="ll-panel__head">
                    <h2 class="ll-panel__title">
                        <span class="ll-ico ll-ico--book ll-ico--lg" aria-hidden="true"></span>
                        {{#str}}codingproblems, local_learnlogic{{/str}}
                    </h2>
                </header>

                <div class="ll-searchrow">
                    <label class="ll-search">
                        <span class="ll-ico ll-ico--search" aria-hidden="true"></span>
                        <input type="search" class="ll-search__input" data-filter="search"
                               placeholder="{{#str}}searchplaceholder, local_learnlogic{{/str}}"
                               autocomplete="off">
                        <kbd class="ll-search__kbd">⌘K</kbd>
                    </label>
                    <div class="ll-diffpills" data-region="diff-pills" role="group" aria-label="{{#str}}difficulty, local_learnlogic{{/str}}">
                        <button type="button" class="ll-diffpill is-active" data-diff="">{{#str}}all, local_learnlogic{{/str}}</button>
                        <button type="button" class="ll-diffpill ll-diffpill--easy" data-diff="easy">{{#str}}easy, local_learnlogic{{/str}}</button>
                        <button type="button" class="ll-diffpill ll-diffpill--medium" data-diff="medium">{{#str}}medium, local_learnlogic{{/str}}</button>
                        <button type="button" class="ll-diffpill ll-diffpill--hard" data-diff="hard">{{#str}}hard, local_learnlogic{{/str}}</button>
                        <button type="button" class="ll-diffpill ll-diffpill--veryhard" data-diff="veryhard">{{#str}}veryhard, local_learnlogic{{/str}}</button>
                    </div>
                    <input type="hidden" data-filter="difficulty" value="">
                </div>

                <div class="ll-populartags">
                    <span class="ll-populartags__label">{{#str}}populartags, local_learnlogic{{/str}}</span>
                    <div class="ll-populartags__list" data-region="popular-tags"></div>
                    <button type="button" class="ll-linkbtn" data-action="toggle-tags">{{#str}}showalltags, local_learnlogic{{/str}}</button>
                    <button type="button" class="ll-linkbtn" data-action="clear-tag-filters" hidden>{{#str}}clearfilters, local_learnlogic{{/str}}</button>
                </div>
                <div class="ll-tagcloud" data-region="tag-cloud" hidden></div>

                <div class="ll-populartags ll-populartags--companies" hidden>
                    <span class="ll-populartags__label">{{#str}}companies, local_learnlogic{{/str}}</span>
                    <div class="ll-populartags__list" data-region="popular-companies"></div>
                    <button type="button" class="ll-linkbtn" data-action="toggle-companies">{{#str}}showallcompanies, local_learnlogic{{/str}}</button>
                    <button type="button" class="ll-linkbtn" data-action="clear-company-filters" hidden>{{#str}}clearfilters, local_learnlogic{{/str}}</button>
                </div>
                <div class="ll-tagcloud ll-tagcloud--companies" data-region="company-cloud" hidden></div>
                <input type="hidden" data-filter="tagid" value="0">

                <div class="ll-statustabs" data-region="status-tabs" role="tablist">
                    <button type="button" class="ll-statustab is-active" data-status="all" role="tab">
                        {{#str}}allproblems, local_learnlogic{{/str}} <span data-count="all">0</span>
                    </button>
                    <button type="button" class="ll-statustab ll-statustab--done" data-status="completed" role="tab">
                        <span class="ll-ico ll-ico--check" aria-hidden="true"></span>
                        {{#str}}completed, local_learnlogic{{/str}} <span data-count="completed">0</span>
                    </button>
                    <button type="button" class="ll-statustab ll-statustab--progress" data-status="inprogress" role="tab">
                        <span class="ll-ico ll-ico--clock" aria-hidden="true"></span>
                        {{#str}}inprogress, local_learnlogic{{/str}} <span data-count="inprogress">0</span>
                    </button>
                    <button type="button" class="ll-statustab ll-statustab--battle" data-status="battled" role="tab">
                        <span class="ll-ico ll-ico--sword" aria-hidden="true"></span>
                        {{#str}}battled, local_learnlogic{{/str}} <span data-count="battled">0</span>
                    </button>
                    <button type="button" class="ll-statustab ll-statustab--todo" data-status="notstarted" role="tab">
                        <span class="ll-ico ll-ico--circle" aria-hidden="true"></span>
                        {{#str}}notstarted, local_learnlogic{{/str}} <span data-count="notstarted">0</span>
                    </button>
                </div>
                <input type="hidden" data-filter="userstatus" value="all">
            </section>

            <section class="ll-results">
                <div class="ll-results__bar">
                    <h2 class="ll-results__title" data-region="found-count">0 {{#str}}problemsfound, local_learnlogic{{/str}}</h2>
                    <div class="ll-results__actions">
                        <button type="button" class="ll-ghostbtn" disabled>{{#str}}sortby, local_learnlogic{{/str}}</button>
                        <button type="button" class="ll-ghostbtn" disabled>{{#str}}morefilters, local_learnlogic{{/str}}</button>
                    </div>
                </div>
                <div class="ll-grid" data-region="grid"></div>
                <nav class="ll-pager" data-region="pager" aria-label="{{#str}}pagination, local_learnlogic{{/str}}" hidden></nav>
            </section>
        </div>
    </div>
</div>
