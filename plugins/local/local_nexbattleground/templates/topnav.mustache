{{!
    @template local_nexbattleground/topnav
}}
<nav class="nbg-topnav" aria-label="NexBattleGround">
    <a class="nbg-topnav__item{{#navlobby}} is-active{{/navlobby}}" href="{{{lobbyurl}}}">
        <span class="nbg-ico nbg-ico--swords" aria-hidden="true"></span>
        {{#str}}lobby, local_nexbattleground{{/str}}
