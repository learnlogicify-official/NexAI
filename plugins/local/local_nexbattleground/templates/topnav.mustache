    <a class="nbg-topnav__item{{#navleaderboard}} is-active{{/navleaderboard}}" href="{{{leaderboardurl}}}">
        <span class="nbg-ico nbg-ico--trophy" aria-hidden="true"></span>
        {{#str}}leaderboard, local_nexbattleground{{/str}}
    </a>
</nav>
