"""NexCodeLab DS grader — generated by CodeRunner template."""
import json
import io
import sys
import traceback

import matplotlib
matplotlib.use("Agg")  # headless

import numpy as np
import pandas as pd

# ---- student code ----
{{ STUDENT_ANSWER }}
# ---- end student code ----

def _load_extra():
    raw = """{{ TEST.extra | e('py') }}"""
    raw = raw.strip()
    if not raw:
        return {}
    try:
        return json.loads(raw)
    except Exception:
        return {"raw": raw}

def _call_fn(name, *args, **kwargs):
    if name not in globals() or not callable(globals()[name]):
        raise NameError("Expected function {!r} in student answer".format(name))
    return globals()[name](*args, **kwargs)

def _frame_from_csv(text):
    return pd.read_csv(io.StringIO(text))

def grade():
    extra = _load_extra()
    mode = extra.get("mode", "stdout")
    fn = extra.get("fn", "solve")

    if mode == "stdout" or not extra:
        # Classic stdin/stdout
        student_output = ""
        try:
            old_stdin, old_stdout = sys.stdin, sys.stdout
            sys.stdin = io.StringIO("""{{ TEST.testcode | e('py') }}""")
            buf = io.StringIO()
            sys.stdout = buf
            if "main" in globals() and callable(main):
                main()
            elif fn in globals() and callable(globals()[fn]):
                result = _call_fn(fn)
                if result is not None:
                    print(result)
            else:
                # Module-level script already ran via import side effects — re-exec not needed
                pass
            student_output = buf.getvalue()
        finally:
            sys.stdin, sys.stdout = old_stdin, old_stdout
        expected = """{{ TEST.expected | e('py') }}""".strip()
        got = student_output.strip()
        ok = got == expected
        print(got)
        if not ok:
            raise AssertionError("Expected {!r}, got {!r}".format(expected, got))
        return

    if mode == "frame":
        fixture = extra.get("fixture", "")
        df = _frame_from_csv(fixture) if fixture else pd.DataFrame()
        got = _call_fn(fn, df.copy())
        if not isinstance(got, pd.DataFrame):
            raise AssertionError("Function {!r} must return a DataFrame".format(fn))
        check = extra.get("check", "equals")
        if check == "shape":
            shape = tuple(extra.get("shape", []))
            if tuple(got.shape) != shape:
                raise AssertionError("Shape {} != {}".format(got.shape, shape))
        elif check == "columns":
            cols = list(extra.get("columns", []))
            if list(got.columns) != cols:
                raise AssertionError("Columns {} != {}".format(list(got.columns), cols))
        else:
            expected_csv = """{{ TEST.expected | e('py') }}""".strip()
            if expected_csv:
                exp = _frame_from_csv(expected_csv)
                pd.testing.assert_frame_equal(
                    got.reset_index(drop=True),
                    exp.reset_index(drop=True),
                    check_dtype=False,
                    atol=1e-6,
                )
            else:
                # Non-empty / row count gate
                min_rows = int(extra.get("min_rows", 1))
                if len(got) < min_rows:
                    raise AssertionError("Expected at least {} rows".format(min_rows))
        print("OK")
        return

    if mode == "metric":
        X_csv = extra.get("X", "")
        y_csv = extra.get("y", "")
        X = _frame_from_csv(X_csv) if X_csv else None
        y = _frame_from_csv(y_csv).iloc[:, 0] if y_csv else None
        score = _call_fn(fn, X, y) if X is not None else _call_fn(fn)
        floor = float(extra.get("floor", 0.0))
        score = float(score)
        if score < floor:
            raise AssertionError("Metric {:.4f} below floor {:.4f}".format(score, floor))
        print("{:.6f}".format(score))
        return

    raise ValueError("Unknown grading mode: {!r}".format(mode))

try:
    grade()
except Exception:
    traceback.print_exc()
    sys.exit(1)
