{{!
    @template local_nexcodelab/leaderboard
}}
<div class="ncl-app ncl-app--bleed"
     data-region="ncl-leaderboard"
     data-label-rank="{{#str}}rank, local_nexcodelab{{/str}}"
     data-label-user="{{#str}}leaderboarduser, local_nexcodelab{{/str}}"
     data-label-institution="{{#str}}institution, local_nexcodelab{{/str}}"
     data-label-xp="{{#str}}xp, local_nexcodelab{{/str}}"
     data-label-solved="{{#str}}missionsdone, local_nexcodelab{{/str}}"
     data-label-you="{{#str}}you, local_nexcodelab{{/str}}"
     data-label-your-rank="{{#str}}yourrank, local_nexcodelab{{/str}}"
     data-label-not-ranked-global="{{#str}}notranked, local_nexcodelab{{/str}}"
     data-label-not-ranked="{{#str}}notrankedincollege, local_nexcodelab{{/str}}"
     data-label-empty="{{#str}}noleaderboard, local_nexcodelab{{/str}}">
    {{> local_nexcodelab/header }}
    <nav class="ncl-topnav" aria-label="NexCodeLab">
        <a class="ncl-topnav__item" href="{{{listurl}}}">
            <span class="ncl-ico ncl-ico--book" aria-hidden="true"></span>
            {{#str}}catalog, local_nexcodelab{{/str}}
        </a>
        <a class="ncl-topnav__item" href="{{{progressurl}}}">
            {{#str}}myprogress, local_nexcodelab{{/str}}
        </a>
        <a class="ncl-topnav__item is-active" href="#">
            <span class="ncl-ico ncl-ico--trophy" aria-hidden="true"></span>
            {{#str}}leaderboard, local_nexcodelab{{/str}}
        </a>
        {{#canmanage}}
            <a class="ncl-topnav__item ncl-topnav__item--right" href="{{{manageurl}}}">{{#str}}manage, local_nexcodelab{{/str}}</a>
        {{/canmanage}}
    </nav>
    <section class="ncl-panel">
        <h2 class="ncl-panel__title">{{#str}}leaderboard, local_nexcodelab{{/str}}</h2>
        <div class="ncl-leaderboard-toolbar">
            <label class="ncl-leaderboard-filter">
                <span>{{#str}}collegefilter, local_nexcodelab{{/str}}</span>
                <select data-filter="institution">
                    <option value="">{{#str}}allcolleges, local_nexcodelab{{/str}}</option>
                </select>
            </label>
            <div class="ncl-my-rank" data-region="my-rank" aria-live="polite"></div>
        </div>
        <div data-region="board"></div>
    </section>
</div>
