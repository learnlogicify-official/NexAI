{{!
    @template local_nexreports/learner_course_progress
    Learner Course Progress (Students sub-report).
}}
<div class="nxr-app" data-region="nxr-learner-course-progress"
     data-label-nodata="{{#str}}nodata, local_nexreports{{/str}}"
     data-label-loaderror="{{#str}}loaderror, local_nexreports{{/str}}"
     data-label-select-learner="{{#str}}selectlearner, local_nexreports{{/str}}"
     data-label-all-years="{{#str}}allyears, local_nexreports{{/str}}"
     data-label-all-departments="{{#str}}alldepartments, local_nexreports{{/str}}"
     data-label-all-colleges="{{#str}}allcolleges, local_nexreports{{/str}}"
     data-label-select-year-first="{{#str}}selectyearfirst, local_nexreports{{/str}}"
     data-label-searching="{{#str}}searching, local_nexreports{{/str}}"
     data-label-nomatches="{{#str}}nomatches, local_nexreports{{/str}}"
     data-label-course="{{#str}}course, local_nexreports{{/str}}"
     data-label-status="{{#str}}status, local_nexreports{{/str}}"
     data-label-enrolledon="{{#str}}enrolledon, local_nexreports{{/str}}"
     data-label-completedon="{{#str}}completedon, local_nexreports{{/str}}"
     data-label-lastaccess="{{#str}}lastaccess, local_nexreports{{/str}}"
     data-label-progress="{{#str}}progress, local_nexreports{{/str}}"
     data-label-grade="{{#str}}grade, local_nexreports{{/str}}"
     data-label-totalactivities="{{#str}}totalactivities, local_nexreports{{/str}}"
     data-label-completedactivities="{{#str}}completedactivitiescol, local_nexreports{{/str}}"
     data-label-attemptedactivities="{{#str}}attemptedactivities, local_nexreports{{/str}}"
     data-label-codingsolved="{{#str}}codingsolved, local_nexreports{{/str}}"
     data-label-codingtotal="{{#str}}codingtotal, local_nexreports{{/str}}"
     data-label-visits="{{#str}}visits, local_nexreports{{/str}}"
     data-label-timespent="{{#str}}timespent, local_nexreports{{/str}}"
     data-label-visitsoncourse="{{#str}}visitsoncourse, local_nexreports{{/str}}"
     data-label-timespentoncourse="{{#str}}timespentoncoursecol, local_nexreports{{/str}}"
     data-label-timespentonsite="{{#str}}timespentonsite, local_nexreports{{/str}}"
     data-label-enrolledcourses="{{#str}}enrolledcourses, local_nexreports{{/str}}"
     data-label-completionprogress="{{#str}}completionprogress, local_nexreports{{/str}}"
     data-label-totalmarks="{{#str}}totalmarks, local_nexreports{{/str}}"
     data-label-totalgrade="{{#str}}totalgrade, local_nexreports{{/str}}"
     data-export-url="{{exporturl}}">

    {{> local_nexreports/shell }}
    {{> local_nexreports/students_subnav }}

    <article class="nxr-card">
        <header class="nxr-card__head">
            <h2 class="nxr-card__title">{{#str}}learnercourseprogress, local_nexreports{{/str}}</h2>
            {{> local_nexreports/table_export }}
        </header>

        <div class="nxr-report-filters">
            {{#showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}college, local_nexreports{{/str}}</span>
                <select data-filter="college">
                    <option value="">{{#str}}allcolleges, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}yearofpassing, local_nexreports{{/str}}</span>
                <select data-filter="year">
                    <option value="">{{#str}}allyears, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{#showdepartment}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}department, local_nexreports{{/str}}</span>
                <select data-filter="department">
                    <option value="">{{#str}}alldepartments, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showdepartment}}
            <div class="nxr-report-filter nxr-report-filter--grow">
                <span class="nxr-report-filter__label">{{#str}}learnerfilter, local_nexreports{{/str}}</span>
                <div class="nxr-combo" data-combo="learner" data-type="user"
                     data-placeholder="{{#str}}selectlearner, local_nexreports{{/str}}">
                    <button type="button" class="nxr-combo__toggle" aria-haspopup="listbox"
                            aria-expanded="false">
                        <span class="nxr-combo__value">{{#str}}selectlearner, local_nexreports{{/str}}</span>
                        <span class="nxr-combo__caret" aria-hidden="true"></span>
                    </button>
                    <div class="nxr-combo__panel" hidden>
                        <input type="text" class="nxr-combo__search" autocomplete="off"
                               placeholder="{{#str}}searchbyuser, local_nexreports{{/str}}">
                        <ul class="nxr-combo__list" role="listbox"></ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="nxr-lcp-summary" data-region="lcp-summary">
            <div class="nxr-skeleton nxr-skeleton--kpis"></div>
        </div>

        <div class="nxr-report-filters nxr-report-filters--table">
            <label class="nxr-search">
                <span class="nxr-search__icon" aria-hidden="true"></span>
                <input type="search" data-filter="search" placeholder="{{#str}}searchbycourse, local_nexreports{{/str}}">
            </label>
        </div>

        <div data-region="report-table">
            <div class="nxr-skeleton nxr-skeleton--table"></div>
        </div>
        <div data-region="pager"></div>
    </article>
</div>
