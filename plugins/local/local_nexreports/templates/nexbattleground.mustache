{{!
    @template local_nexreports/nexbattleground
    NexBattleGround leaderboard report.
}}
<div class="nxr-app" data-region="nxr-battle"
     data-label-nodata="{{#str}}nodata, local_nexreports{{/str}}"
     data-label-loaderror="{{#str}}loaderror, local_nexreports{{/str}}"
     data-label-all-cohorts="{{#str}}allcohorts, local_nexreports{{/str}}"
     data-label-all-colleges="{{#str}}allcolleges, local_nexreports{{/str}}"
     data-label-all-years="{{#str}}allyears, local_nexreports{{/str}}"
     data-label-all-departments="{{#str}}alldepartments, local_nexreports{{/str}}"
     data-label-firstname="{{#str}}firstname, local_nexreports{{/str}}"
     data-label-lastname="{{#str}}lastname, local_nexreports{{/str}}"
     data-label-username="{{#str}}username, local_nexreports{{/str}}"
     data-label-institution="{{#str}}college, local_nexreports{{/str}}"
     data-label-yearofpassing="{{#str}}yearofpassing, local_nexreports{{/str}}"
     data-label-department="{{#str}}department, local_nexreports{{/str}}"
     data-label-battlexp="{{#str}}battlexp, local_nexreports{{/str}}"
     data-label-wins="{{#str}}battlewins, local_nexreports{{/str}}"
     data-label-losses="{{#str}}battlelosses, local_nexreports{{/str}}"
     data-label-ties="{{#str}}battleties, local_nexreports{{/str}}"
     data-label-battles="{{#str}}battlecount, local_nexreports{{/str}}"
     data-label-winrate="{{#str}}battlewinrate, local_nexreports{{/str}}"
     data-label-attempts="{{#str}}battleattempts, local_nexreports{{/str}}"
     data-label-lastactivity="{{#str}}battlelastactivity, local_nexreports{{/str}}"
     data-export-url="{{exporturl}}">

    {{> local_nexreports/shell }}

    <div class="nxr-kpis nxr-kpis--practice" data-region="battle-kpis">
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}battleactive, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="activebattlers">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}battlefinished, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="finishedbattles">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}battletotalwins, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalwins">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}battlexp, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalxp">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}battleattempts, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalsubmissions">—</strong>
                </div>
            </div>
        </article>
    </div>

    <article class="nxr-card">
        <header class="nxr-card__head">
            <h2 class="nxr-card__title">{{#str}}battleleaderboard, local_nexreports{{/str}}</h2>
            {{> local_nexreports/table_export }}
        </header>
        <p class="nxr-card__hint">{{#str}}battleleaderboard_help, local_nexreports{{/str}}</p>
        <div class="nxr-report-filters">
            {{#showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}college, local_nexreports{{/str}}</span>
                <select data-filter="college" name="nxr_bt_college" autocomplete="off">
                    <option value="" selected>{{#str}}allcolleges, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}yearofpassing, local_nexreports{{/str}}</span>
                <select data-filter="year" name="nxr_bt_year" autocomplete="off">
                    <option value="" selected>{{#str}}allyears, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{#showdepartment}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}department, local_nexreports{{/str}}</span>
                <select data-filter="department" name="nxr_bt_department" autocomplete="off">
                    <option value="" selected>{{#str}}alldepartments, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showdepartment}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}cohortfilter, local_nexreports{{/str}}</span>
                <select data-filter="cohort">
                    <option value="0">{{#str}}allcohorts, local_nexreports{{/str}}</option>
                </select>
            </div>
            <label class="nxr-search">
                <span class="nxr-search__icon" aria-hidden="true"></span>
                <input type="search" data-filter="search" placeholder="{{#str}}searchbyuser, local_nexreports{{/str}}">
            </label>
        </div>
        <div data-region="battle-table">
            <div class="nxr-skeleton nxr-skeleton--table"></div>
        </div>
    </article>
</div>
