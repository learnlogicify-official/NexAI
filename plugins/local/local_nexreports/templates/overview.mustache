            <header class="nxr-card__head">
                <h2 class="nxr-card__title">{{#str}}siteoverview, local_nexreports{{/str}}</h2>
                <div class="nxr-card__actions">
                    <p class="nxr-card__meta">{{#str}}lastupdated, local_nexreports{{/str}}</p>
                    {{> local_nexreports/chart_export }}
                </div>
            </header>
            <div class="nxr-summary" data-region="overview-summary"></div>
            <div class="nxr-chart" data-region="overview-chart" data-export-chart="overview-chart"></div>
        </article>
        <article class="nxr-card" data-chart-card="visits">
            <header class="nxr-card__head">
                <h2 class="nxr-card__title">{{#str}}visitsonsite, local_nexreports{{/str}}</h2>
                <div class="nxr-card__actions">
                    {{> local_nexreports/chart_export }}
                </div>
            </header>
            <div class="nxr-report-filters">
                <div class="nxr-report-filter">
                    <span class="nxr-report-filter__label" id="nxr-lbl-visits-user">
                        {{#str}}userfilter, local_nexreports{{/str}}
                    </span>
                    <div class="nxr-combo" data-combo="visits-user" data-type="user"
                         data-placeholder="{{#str}}allusers, local_nexreports{{/str}}">
                        <button type="button" class="nxr-combo__toggle" aria-haspopup="listbox"
                                aria-expanded="false" aria-labelledby="nxr-lbl-visits-user">
                            <span class="nxr-combo__value">{{#str}}allusers, local_nexreports{{/str}}</span>
                            <span class="nxr-combo__caret" aria-hidden="true"></span>
                        </button>
                        <div class="nxr-combo__panel" hidden>
                            <input type="text" class="nxr-combo__search" autocomplete="off"
                                   placeholder="{{#str}}searchbyuser, local_nexreports{{/str}}"
                                   aria-label="{{#str}}searchbyuser, local_nexreports{{/str}}">
                            <ul class="nxr-combo__list" role="listbox"></ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="nxr-summary" data-region="visits-summary"></div>
            <div class="nxr-chart" data-region="visits-chart" data-export-chart="visits-chart"></div>
