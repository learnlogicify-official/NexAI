{{!
    @template local_nexreports/placeholder
    Temporary tab body while a report is being built.
}}
<div class="nxr-app">
    {{> local_nexreports/shell }}
    <article class="nxr-card">
        <header class="nxr-card__head">
            <h2 class="nxr-card__title">{{heading}}</h2>
        </header>
        <p class="nxr-empty">{{message}}</p>
    </article>
</div>
