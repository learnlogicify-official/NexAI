{{!
    @template local_nexreports/portfolio_github
    NexPortfolio GitHub learners report.
}}
<div class="nxr-app" data-region="nxr-portfolio-github"
     data-label-nodata="{{#str}}nodata, local_nexreports{{/str}}"
     data-label-loaderror="{{#str}}loaderror, local_nexreports{{/str}}"
     data-label-all-cohorts="{{#str}}allcohorts, local_nexreports{{/str}}"
     data-label-all-colleges="{{#str}}allcolleges, local_nexreports{{/str}}"
     data-label-all-years="{{#str}}allyears, local_nexreports{{/str}}"
     data-label-all-departments="{{#str}}alldepartments, local_nexreports{{/str}}"
     data-label-firstname="{{#str}}firstname, local_nexreports{{/str}}"
     data-label-lastname="{{#str}}lastname, local_nexreports{{/str}}"
     data-label-username="{{#str}}username, local_nexreports{{/str}}"
     data-label-institution="{{#str}}college, local_nexreports{{/str}}"
     data-label-yearofpassing="{{#str}}yearofpassing, local_nexreports{{/str}}"
     data-label-department="{{#str}}department, local_nexreports{{/str}}"
     data-label-login="{{#str}}portfoliogithublogin, local_nexreports{{/str}}"
     data-label-contributions="{{#str}}portfoliogithubcontributions, local_nexreports{{/str}}"
     data-label-commits="{{#str}}portfoliogithubcommits, local_nexreports{{/str}}"
     data-label-prs="{{#str}}portfoliogithubprs, local_nexreports{{/str}}"
     data-label-issues="{{#str}}portfoliogithubissues, local_nexreports{{/str}}"
     data-label-reviews="{{#str}}portfoliogithubreviews, local_nexreports{{/str}}"
     data-label-repos="{{#str}}portfoliogithubrepos, local_nexreports{{/str}}"
     data-label-followers="{{#str}}portfoliogithubfollowers, local_nexreports{{/str}}"
     data-label-following="{{#str}}portfoliogithubfollowing, local_nexreports{{/str}}"
     data-label-stars="{{#str}}portfoliogithubstars, local_nexreports{{/str}}"
     data-label-forks="{{#str}}portfoliogithubforks, local_nexreports{{/str}}"
     data-label-projects="{{#str}}portfoliogithubprojects, local_nexreports{{/str}}"
     data-label-lastfetch="{{#str}}portfoliogithublastfetch, local_nexreports{{/str}}"
     data-export-url="{{exporturl}}">

    {{> local_nexreports/shell }}
    {{> local_nexreports/portfolio_subnav }}

    <div class="nxr-kpis nxr-kpis--portfolio-github" data-region="portfolio-github-kpis">
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}portfoliogithubconnected, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="connectedlearners">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}portfoliogithubcontributions, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalcontributions">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}portfoliogithubrepos, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalrepos">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}portfoliogithubstars, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalstars">—</strong>
                </div>
            </div>
        </article>
        <article class="nxr-kpi">
            <div class="nxr-kpi__body">
                <div class="nxr-kpi__label">{{#str}}portfoliogithubprojects, local_nexreports{{/str}}</div>
                <div class="nxr-kpi__metrics">
                    <strong class="nxr-kpi__value" data-kpi="totalprojects">—</strong>
                </div>
            </div>
        </article>
    </div>

    <article class="nxr-card">
        <header class="nxr-card__head">
            <h2 class="nxr-card__title">{{#str}}portfoliogithublearners, local_nexreports{{/str}}</h2>
            {{> local_nexreports/table_export }}
        </header>
        <p class="nxr-card__hint">{{#str}}portfoliogithublearners_help, local_nexreports{{/str}}</p>
        <div class="nxr-report-filters">
            {{#showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}college, local_nexreports{{/str}}</span>
                <select data-filter="college" name="nxr_pgh_college" autocomplete="off">
                    <option value="" selected>{{#str}}allcolleges, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}yearofpassing, local_nexreports{{/str}}</span>
                <select data-filter="year" name="nxr_pgh_year" autocomplete="off">
                    <option value="" selected>{{#str}}allyears, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{#showdepartment}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}department, local_nexreports{{/str}}</span>
                <select data-filter="department" name="nxr_pgh_department" autocomplete="off">
                    <option value="" selected>{{#str}}alldepartments, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showdepartment}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}cohortfilter, local_nexreports{{/str}}</span>
                <select data-filter="cohort">
                    <option value="0">{{#str}}allcohorts, local_nexreports{{/str}}</option>
                </select>
            </div>
            <label class="nxr-search">
                <span class="nxr-search__icon" aria-hidden="true"></span>
                <input type="search" data-filter="search" placeholder="{{#str}}searchbyuser, local_nexreports{{/str}}">
            </label>
        </div>
        <div data-region="portfolio-github-table">
            <div class="nxr-skeleton nxr-skeleton--table"></div>
        </div>
    </article>
</div>
