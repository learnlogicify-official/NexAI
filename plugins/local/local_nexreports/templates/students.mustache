{{!
    @template local_nexreports/students
    All learner summary / student engagement.
}}
<div class="nxr-app" data-region="nxr-students"
     data-label-nodata="{{#str}}nodata, local_nexreports{{/str}}"
     data-label-loaderror="{{#str}}loaderror, local_nexreports{{/str}}"
     data-label-all-courses="{{#str}}allcourses, local_nexreports{{/str}}"
     data-label-all-years="{{#str}}allyears, local_nexreports{{/str}}"
     data-label-all-departments="{{#str}}alldepartments, local_nexreports{{/str}}"
     data-label-all-colleges="{{#str}}allcolleges, local_nexreports{{/str}}"
     data-label-all-users="{{#str}}allusers, local_nexreports{{/str}}"
     data-label-firstname="{{#str}}firstname, local_nexreports{{/str}}"
     data-label-lastname="{{#str}}lastname, local_nexreports{{/str}}"
     data-label-username="{{#str}}username, local_nexreports{{/str}}"
     data-label-email="{{#str}}email, local_nexreports{{/str}}"
     data-label-institution="{{#str}}institution, local_nexreports{{/str}}"
     data-label-department="{{#str}}department, local_nexreports{{/str}}"
     data-label-yearofpassing="{{#str}}yearofpassing, local_nexreports{{/str}}"
     data-label-status="{{#str}}status, local_nexreports{{/str}}"
     data-label-lastaccess="{{#str}}lastaccess, local_nexreports{{/str}}"
     data-label-enrolledcourses="{{#str}}enrolledcourses, local_nexreports{{/str}}"
     data-label-inprogresscourses="{{#str}}inprogresscourses, local_nexreports{{/str}}"
     data-label-completedcourses="{{#str}}completedcourses, local_nexreports{{/str}}"
     data-label-completionprogress="{{#str}}completionprogress, local_nexreports{{/str}}"
     data-label-totalgrade="{{#str}}totalgrade, local_nexreports{{/str}}"
     data-label-codingsolved="{{#str}}codingsolved, local_nexreports{{/str}}"
     data-label-codingtotal="{{#str}}codingtotal, local_nexreports{{/str}}"
     data-label-timespentonsite="{{#str}}timespentonsite, local_nexreports{{/str}}"
     data-label-timespentoncourse="{{#str}}timespentoncoursecol, local_nexreports{{/str}}"
     data-label-activitiescompleted="{{#str}}activitiescompleted, local_nexreports{{/str}}"
     data-label-visitsoncourse="{{#str}}visitsoncourse, local_nexreports{{/str}}"
     data-label-completedassignments="{{#str}}completedassignments, local_nexreports{{/str}}"
     data-label-completedquizzes="{{#str}}completedquizzes, local_nexreports{{/str}}"
     data-label-completedscorms="{{#str}}completedscorms, local_nexreports{{/str}}"
     data-label-totalvisits="{{#str}}totalvisits, local_nexreports{{/str}}"
     data-label-avgvisits="{{#str}}avgvisits, local_nexreports{{/str}}"
     data-label-totallearners="{{#str}}totallearners, local_nexreports{{/str}}"
     data-label-totaltimespent="{{#str}}totaltimespentoncourses, local_nexreports{{/str}}"
     data-label-avgtimespent="{{#str}}avgtimespentoncourses, local_nexreports{{/str}}"
     data-export-url="{{exporturl}}">

    {{> local_nexreports/shell }}
    {{> local_nexreports/students_subnav }}

    <article class="nxr-card">
        <header class="nxr-card__head">
            <h2 class="nxr-card__title">{{#str}}studentengagement, local_nexreports{{/str}}</h2>
            {{> local_nexreports/table_export }}
        </header>
        <div class="nxr-report-filters">
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}coursefilter, local_nexreports{{/str}}</span>
                <select data-filter="course">
                    <option value="0">{{#str}}allcourses, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{#showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}college, local_nexreports{{/str}}</span>
                <select data-filter="college" name="nxr_college" autocomplete="off">
                    <option value="" selected>{{#str}}allcolleges, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showcollege}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}yearofpassing, local_nexreports{{/str}}</span>
                <select data-filter="year" name="nxr_year" autocomplete="off">
                    <option value="" selected>{{#str}}allyears, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{#showdepartment}}
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}department, local_nexreports{{/str}}</span>
                <select data-filter="department" name="nxr_department" autocomplete="off">
                    <option value="" selected>{{#str}}alldepartments, local_nexreports{{/str}}</option>
                </select>
            </div>
            {{/showdepartment}}
        </div>

        <div class="nxr-learner-summary" data-region="students-summary">
            <div class="nxr-skeleton nxr-skeleton--kpis"></div>
        </div>

        <div class="nxr-report-filters nxr-report-filters--table">
            <label class="nxr-search">
                <span class="nxr-search__icon" aria-hidden="true"></span>
                <input type="search" data-filter="search" placeholder="{{#str}}searchbyuser, local_nexreports{{/str}}">
            </label>
            <div class="nxr-report-filter">
                <span class="nxr-report-filter__label">{{#str}}inactivefilter, local_nexreports{{/str}}</span>
                <select data-filter="inactive">
                    <option value="all">{{#str}}allusers, local_nexreports{{/str}}</option>
                    <option value="never">{{#str}}inactivenever, local_nexreports{{/str}}</option>
                    <option value="1">{{#str}}inactive1m, local_nexreports{{/str}}</option>
                    <option value="3">{{#str}}inactive3m, local_nexreports{{/str}}</option>
                    <option value="6">{{#str}}inactive6m, local_nexreports{{/str}}</option>
                    <option value="suspended">{{#str}}excludesuspended, local_nexreports{{/str}}</option>
                </select>
            </div>
        </div>

        <div data-region="students-table">
            <div class="nxr-skeleton nxr-skeleton--table"></div>
        </div>
        <div data-region="pager"></div>
    </article>
</div>
