# NexStack — ensure COOP/COEP reach the browser for WebContainers.
# Apache only. Nginx users: see README.
<IfModule mod_headers.c>
  <Files "wcframe.php">
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "credentialless"
    Header always set Permissions-Policy "cross-origin-isolated=*"
  </Files>
</IfModule>
